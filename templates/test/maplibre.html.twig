{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Pinned, as the widget is on the Septima tab: a library that changes
       under the comparison would make the comparison worth nothing. #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.css">
{% endblock %}

{# Loaded as an entrypoint rather than imported inline: a relative import
   is resolved through the importmap, and only an entrypoint's own modules
   are put there. The map starts itself from the element that carries the
   description it is to draw. #}
{% block importmap %}{{ importmap(['app', 'test/maplibre']) }}{% endblock %}

{% block content %}
    <h2 class="test-map-heading">{{ type }}</h2>

    {{ include('test/_tabs.html.twig') }}

    <div class="test-map-toggles"></div>

    <div class="test-map" data-spec="{{ path('test_spec', {type: type, multiply: multiply}) }}"></div>

    <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>

{% endblock %}
