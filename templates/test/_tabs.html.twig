{# The same data, the same colours and the same view, drawn by three different
   libraries. Which one is worth building on is a question about how they cope
   with more data than we have yet, which is what the scale below asks for. #}
<div class="test-map-bar">
    <ul class="nav nav-tabs test-map-tabs">
        {% for name, page in {septima: null, leaflet: 'leaflet', maplibre: 'maplibre'} %}
            {% set parameters = (page ? {path: page} : {})|merge(multiply > 1 ? {multiply: multiply} : {}) %}
            <li class="nav-item">
                <a class="nav-link{{ name == library ? ' active' }}" href="{{ path('test_default', parameters) }}">
                    {{ name == 'maplibre' ? 'MapLibre' : name|capitalize }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <form class="test-map-scale" method="get">
        <label for="test-map-multiply">Datamængde</label>
        <select class="form-select form-select-sm" id="test-map-multiply" name="multiply">
            {% for choice in [1, 5, 10, 25, 50] %}
                <option value="{{ choice }}"{{ choice == multiply ? ' selected' }}>{{ choice }}×</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-secondary">Vis</button></noscript>
    </form>

    <div class="test-map-stats"></div>
</div>

<script>
    document.getElementById('test-map-multiply').addEventListener('change', function () {
        this.form.submit();
    });
</script>
